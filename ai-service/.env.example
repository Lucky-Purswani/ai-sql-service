# ==========================================
# 1. NeonDB (DB B — Your App's Database)
# ==========================================
DATABASE_URL=your_neondb_connection_string_here

# ==========================================
# 2. Mistral AI Credentials
# ==========================================
# Get this from https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=your_mistral_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Email Configuration (e.g., Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
MISTRAL_LLM_MODEL=mistral-small-latest
MISTRAL_EMBED_MODEL=mistral-embed

# ==========================================
# 3. JWT Authentication
# ==========================================
# Used to sign JWT tokens sent to React users after login.
# Generate a strong value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_strong_random_secret_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ==========================================
# 4. Fernet Encryption
# ==========================================
# Used to encrypt user database URLs before storing in DB B.
# Generate a valid Fernet key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change_this_to_a_real_fernet_key_in_production

# ==========================================
# 5. App Settings
# ==========================================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
